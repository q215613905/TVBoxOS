<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="@dimen/vs_40"
    android:paddingTop="@dimen/vs_24"
    android:paddingRight="@dimen/vs_40"
    android:paddingBottom="@dimen/vs_24">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/vs_12"
        android:layout_marginBottom="@dimen/vs_8"
        android:orientation="vertical"
        android:weightSum="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingLeft="@dimen/vs_20"
                android:paddingRight="@dimen/vs_20">

                <ImageView
                    android:id="@+id/ivTransferQr"
                    android:layout_width="@dimen/vs_220"
                    android:layout_height="@dimen/vs_220"
                    android:layout_marginBottom="@dimen/vs_14"
                    android:background="@drawable/shape_dialog_bg_main"
                    android:padding="@dimen/vs_8" />

                <TextView
                    android:id="@+id/tvTransferAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.2"
                    android:textColor="@color/color_FFFFFF"
                    android:textSize="@dimen/ts_20" />

                <ProgressBar
                    android:id="@+id/transferProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="@dimen/vs_320"
                    android:layout_height="@dimen/vs_8"
                    android:layout_marginTop="@dimen/vs_14"
                    android:max="100" />

                <TextView
                    android:id="@+id/tvTransferStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vs_8"
                    android:gravity="center"
                    android:text="请在扫码后的网页查看上传进度"
                    android:textColor="@color/color_CCFFFFFF"
                    android:textSize="@dimen/ts_18" />
            </LinearLayout>

            <View
                android:layout_width="@dimen/vs_1"
                android:layout_height="match_parent"
                android:background="@color/color_33FFFFFF" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="@dimen/vs_30"
                android:layout_weight="3"
                android:orientation="vertical"
                android:paddingTop="@dimen/vs_8"
                android:paddingBottom="@dimen/vs_10">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/vs_12"
                    android:text="已上传文件"
                    android:textColor="@color/color_FFFFFF"
                    android:textSize="@dimen/ts_24" />

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_scrollview"
                    android:fillViewport="true"
                    android:paddingLeft="@dimen/vs_10"
                    android:paddingTop="@dimen/vs_6"
                    android:paddingRight="@dimen/vs_10"
                    android:paddingBottom="@dimen/vs_6"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/transferFileList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
