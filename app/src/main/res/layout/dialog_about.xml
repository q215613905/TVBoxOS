<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/shape_danmu_setting_bg"
    android:orientation="vertical"
    android:padding="@dimen/vs_30">

    <TextView
        android:layout_width="@dimen/vs_600"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="@dimen/ts_50"
        android:lineSpacingMultiplier="0"
        android:text="本程序为个人研究自己测试使用，勿传播或用于商业用途。\n\n源码地址\nhttps://github.com/bkys/TVBoxOS"
        android:textColor="@color/dialog_text_primary"
        android:textSize="@dimen/ts_24" />

    <TextView
        android:id="@+id/tvVersion"
        android:layout_width="@dimen/vs_600"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_30"
        android:text="当前版本"
        android:textColor="@color/dialog_text_primary"
        android:textSize="@dimen/ts_22" />

    <Button
        android:id="@+id/btnCheckUpdate"
        android:layout_width="@dimen/vs_600"
        android:layout_height="@dimen/vs_80"
        android:layout_marginTop="@dimen/vs_30"
        android:background="@drawable/shape_danmu_setting_bg"
        android:text="检查更新"
        android:textColor="@color/dialog_text_primary"
        android:textSize="@dimen/ts_24" />

</LinearLayout>
